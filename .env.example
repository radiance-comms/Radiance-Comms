# Environment example for Radiance-Comms bot

# Put your bot token here (DO NOT commit the real token)
DISCORD_TOKEN=your_new_bot_token_here
CLIENT_ID=1561213870486454322
GUILD_ID=1560366921105277071

# Categories (where ticket channels will be created)
# COMMISSION_CATEGORY_ID: category for commission tickets
COMMISSION_CATEGORY_ID=1560661080353538129
# SUPPORT_CATEGORY_ID: category for general support & admin support tickets
SUPPORT_CATEGORY_ID=1560660976334798899
# PARTNERSHIP_CATEGORY_ID: category for partnership-related tickets
PARTNERSHIP_CATEGORY_ID=1560661044655816784
# APPLICATION_CATEGORY_ID: category for application tickets
APPLICATION_CATEGORY_ID=1560660922035609691

# Panel channels where the bot posts the "open ticket" buttons
# These are the existing channels (panels) where users click buttons to open tickets
COMMISSION_PANEL_ID=1560512621579472956
GENERIC_TICKET_PANEL_ID=1561123638860718160
APPLICATION_PANEL_ID=1561165525780926544
# Optional: a channel visible only to admins where an Admin Support button can be posted
# Set this if you want the Admin panel to be separate and only visible to admins
ADMIN_PANEL_CHANNEL_ID=

# Commission logging channel (bot will post new commission summaries here)
COMMISSIONS_LOG_CHANNEL_ID=1560661327637123172

# Staff & manager roles
# STAFF_ROLE_ID: general staff role who should have access to most tickets
STAFF_ROLE_ID=1560805627826020472
# ADMIN_ONLY_ROLE_ID: role that represents server admins — used to grant viewing access to admin tickets
ADMIN_ONLY_ROLE_ID=1561492115937042502
# EVENTS_ROLE_ID: role that should have access to event/GWY tickets
EVENTS_ROLE_ID=1560806440556437515
# PARTNER_MANAGER_ROLE_ID: role for partnership managers
PARTNER_MANAGER_ROLE_ID=1560805999466520576

# Member roles (who can open tickets)
# CLIENTS_ROLE_ID: members/clients who can open all ticket types (commission, admin, etc.)
CLIENTS_ROLE_ID=1560877324503744532
# UNVERIFIED_ROLE_ID: limited members who may only open Support or Admin Support tickets
UNVERIFIED_ROLE_ID=1560877389037437069

# Optional behavior flags
# If you want ticket panel messages only posted on startup set POST_PANELS_ON_START=true
POST_PANELS_ON_START=true
